{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app.py": {
      "maxDuration": 10,
      "includeFiles": [
        "europe-work-finder.html",
        "europe-work-finder_v2.html",
        "europe-work-finder_v3.html"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/app.py"
    }
  ]
}
